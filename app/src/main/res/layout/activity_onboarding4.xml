<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".Onboarding4Activity">

    <!-- Ilustração provisória -->
    <TextView
        android:id="@+id/txtIlustracao"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginTop="48dp"
        android:gravity="center"
        android:text="📚"
        android:textSize="100sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.32" />

    <!-- Título -->
    <TextView
        android:id="@+id/txtTitulo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="28dp"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="Aprenda no seu ritmo"
        android:textColor="#123B63"
        android:textSize="25sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/txtIlustracao"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Descrição -->
    <TextView
        android:id="@+id/txtDescricao"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="36dp"
        android:layout_marginEnd="36dp"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="Descubra como usar seu celular e o SeniorLink com orientações simples, passo a passo."
        android:textColor="#52677A"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/txtTitulo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Indicadores -->
    <LinearLayout
        android:id="@+id/indicadores"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="38dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:layout_width="5dp"
            android:layout_height="5dp"
            android:layout_margin="3dp"
            android:background="#B9D9E1" />

        <View
            android:layout_width="5dp"
            android:layout_height="5dp"
            android:layout_margin="3dp"
            android:background="#B9D9E1" />

        <View
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_margin="3dp"
            android:background="#159C8C" />

    </LinearLayout>

    <!-- Pular -->
    <TextView
        android:id="@+id/txtPular"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="24dp"
        android:padding="12dp"
        android:text="Pular"
        android:textColor="#123B63"
        android:textSize="14sp"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Avançar -->
    <ImageButton
        android:id="@+id/btnAvancar"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_botao_redondo"
        android:src="@drawable/ic_arrow_forward"
        android:scaleType="centerInside"
        android:padding="15dp"
        android:contentDescription="Avançar para a tela principal"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>